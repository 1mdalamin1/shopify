<div class="flex items-center justify-between right-0  bg-[#F0F0F0] rounded-full py-2 px-4 w-28">
                                                <script>
                                                    jQuery(document).ready(function($) {
                                                        $('.minus').on('click', function(){
                                                        let quantity = parseInt($(this).siblings('.quantity').text());
                                                        if (quantity > 1){
                                                            quantity--;
                                                            $(this).siblings('.quantity').text(quantity);
                                                            $('.quantity-hidden').val(quantity);
                                                        }
                                                        {% if type == 'cart' %}
                                                            // submit form when quantity change
                                                            $(this).closest('form').submit();
                                                        {% endif %}
                                                    });
                                                    $('.plus').on('click', function() {
                                                        let quantity =parseInt($(this).siblings('.quantity').text());
                                                        quantity++;
                                                        $(this).siblings('.quantity').text(quantity);
                                                        $('.quantity-hidden').val(quantity);
                                                        {% if type == 'cart' %}
                                                            // submit form when quantity change
                                                            $(this).closest('form').submit();
                                                        {% endif %}
                                                    });
                                                        
                                                    });
                                                </script>
                                                    <button type="button" class="cursor-pointer minus">-</button>
                                                    <span class="quantity px-4">
                                                        {% if type == 'cart' %}
                                                            {{ quantity }}
                                                            {% else %}
                                                                1
                                                        {% endif %}
                                                    </span>
                                                    <button type="button" class="cursor-pointer plus">+</button>
                                                    <input name="{% if type == 'cart' %}updates[{{ item_key }}]{% else %}quantity{% endif %}" type="hidden" min="1" value="1" class="py-2  w-38 bg-[#F0EEED] text-center rounded-full mr-2 quantity-hidden">
                                            </div>