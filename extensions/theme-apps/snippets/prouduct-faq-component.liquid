<div class="faq-wrap w-full bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">

  {%- if block.settings.title != blank -%}
    <pre style="background:#eee; color:#333; font-size:12px;">{{ block.settings | json }}</pre>

    <h2 class="faq-section-title" style="text-align: {{ block.settings.title_alignment }}; font-size: {{ block.settings.section_title_size }}px; color: {{ block.settings.section_title_color }}; margin-bottom: 20px;">
      {{ block.settings.title }}
    </h2>
  {%- else -%}
    {% comment %} <h2 class="faq-section-title" style="color:red;">No title found in section.settings</h2> {% endcomment %}
  {%- endif -%}


  <div id="fullWidthTabContent" class="border-t border-gray-200 dark:border-gray-600">
    <div class="p-4 bg-white rounded-lg dark:bg-gray-800" id="faq" role="tabpanel" aria-labelledby="faq-tab">
      <div id="accordion-flush" data-accordion="collapse" data-active-classes="faq-wrap bg-white dark:bg-gray-800 text-gray-900 dark:text-white" data-inactive-classes="text-gray-500 dark:text-gray-400">
        
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'faq' -%}
              <h2 id="accordion-flush-heading-{{ forloop.index }}" {{ block.shopify_attributes }}>
                <button type="button" class="faq-title flex items-center justify-between w-full py-5 font-medium text-left rtl:text-right text-gray-500 border-b border-gray-200 dark:border-gray-700 dark:text-gray-400" data-accordion-target="#accordion-flush-body-{{ forloop.index }}" aria-expanded="{% if forloop.first and block.settings.first_item_open %}true{% else %}false{% endif %}" aria-controls="accordion-flush-body-{{ forloop.index }}">
                  <span>{{ block.settings.question }}</span>
                  <svg data-accordion-icon class="w-3 h-3 {% if forloop.first and block.settings.first_item_open %}rotate-180{% endif %} shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
                  </svg>
                </button>
              </h2>
              <div id="accordion-flush-body-{{ forloop.index }}" class="{% unless forloop.first and block.settings.first_item_open %}hidden{% endunless %} faq-dec" aria-labelledby="accordion-flush-heading-{{ forloop.index }}">
                <div class="py-5 border-b border-gray-200 dark:border-gray-700">
                  {{ block.settings.answer }}
                </div>
              </div>
          {%- endcase -%}
        {%- else -%}
          {%- comment -%} Default FAQs if none are added {%- endcomment -%}
          {%- for i in (1..3) -%}
            <h2 id="accordion-flush-heading-{{ forloop.index }}">
              <button type="button" class="faq-title flex items-center justify-between w-full py-5 font-medium text-left rtl:text-right text-gray-500 border-b border-gray-200 dark:border-gray-700 dark:text-gray-400" data-accordion-target="#accordion-flush-body-{{ forloop.index }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="accordion-flush-body-{{ forloop.index }}">
                <span>Frequently asked question #{{ forloop.index }}?</span>
                <svg data-accordion-icon class="w-3 h-3 {% if forloop.first %}rotate-180{% endif %} shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
                </svg>
              </button>
            </h2>
            <div id="accordion-flush-body-{{ forloop.index }}" class="{% unless forloop.first %}hidden{% endunless %} faq-dec" aria-labelledby="accordion-flush-heading-{{ forloop.index }}">
              <div class="py-5 border-b border-gray-200 dark:border-gray-700">
                <p class="mb-2 text-gray-500 dark:text-gray-400">This is the answer to the frequently asked question #{{ forloop.index }}. You can replace this with your own content.</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
        
      </div>
    </div>
  </div>
</div>

{{ 'tailwind.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .faq-wrap {
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    margin: {{ block.settings.margin_top | default: 20 }}px 0 {{ block.settings.margin_bottom | default: 20 }}px 0;
    padding: {{ block.settings.padding | default: 20 }}px;
  }
  
  .faq-title {
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_weight }};
    font-size: {{ block.settings.title_size }}px;
  }
  
  .faq-title:hover {
    color: {{ block.settings.title_hover_color }};
  }
  
  .faq-dec {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }
  
  .faq-dec a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }
  
  .faq-dec a:hover {
    color: {{ block.settings.link_hover_color }};
  }
  
  [data-accordion-icon].rotate-180 {
    transform: rotate(180deg);
    transition: transform 0.2s ease-in-out;
  }
  
  [data-accordion-icon]:not(.rotate-180) {
    transform: rotate(0deg);
    transition: transform 0.2s ease-in-out;
  }
  
  {%- if block.settings.custom_css != blank -%}
    {{ block.settings.custom_css }}
  {%- endif -%}
{%- endstyle -%}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const accordionButtons = document.querySelectorAll('[data-accordion-target]');
  
  accordionButtons.forEach(button => {
    button.addEventListener('click', function() {
      const targetId = this.getAttribute('data-accordion-target');
      const target = document.querySelector(targetId);
      {% comment %} const hiddenId = document.getElementById(targetId); {% endcomment %}
      const icon = this.querySelector('[data-accordion-icon]');
      
      console.log('Target ID:', targetId);
      console.log('Target Element:', target);
      // Toggle visibility
      target.classList.toggle('hidden');
      {% comment %} hiddenId.classList.toggle('hidden'); {% endcomment %}
      
      // Toggle icon rotation
      icon.classList.toggle('rotate-180');
      
      // Update aria-expanded attribute
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !isExpanded);
    });
  });
});
</script>

