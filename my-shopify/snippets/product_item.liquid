<div class="single-product-box group text-black relative">

  <div class="absolute top-3 right-3 hidden group-hover:flex flex-col" >
    
    <button data-product-handle="{{ product.handle }}" class="bg-white shadow p-2 mb-2 wishlist-btn cursor-pointer">
      <span class="text">
        {% render 'heart-icon' %}
      </span>
      <span class="wish-listed hidden">
        {% render 'heart-icon-solid' %}
      </span>
    </button>

    <button data-product-handle="{{ product.handle }}" class="bg-black text-white shadow p-2 cursor-pointer quick-view-btn hover:text-blue-600 " >
      <span class="text">
        {% render 'quick-view-icon' %}
      </span>
      <span class="loading-icon hidden ">
        {% render 'loading-icon' %}
      </span>
    </button>
  </div>

  
  
  <a href="{{ product.url }}" class="bg-[#F0EEED] inline-block rounded-lg mb-6 p-2 ">
    <img class="w-full rounded-lg" src="{{ product.featured_image | img_url: 'large' }}" alt="{{ product.title }}" width="" height="">
    <h3 class="text-xl capitalize my-2">{{ product.title }}</h3>
    
    <div class="flex items-center mb-4 text-[#a4a0a0]">
      <div class="flex mr-2">
        {% for i in (1..5) %}
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="17" viewBox="0 0 19 17" fill="none">
            <path d="M9.24494 0.255005L11.8641 5.89491L18.0374 6.6431L13.4829 10.8769L14.679 16.9793L9.24494 13.956L3.8109 16.9793L5.00697 10.8769L0.452479 6.6431L6.62573 5.89491L9.24494 0.255005Z" fill="#FFC633"/>
          </svg>
        {% endfor %}
      </div>
      4.5/5
    </div>
    <div class="text-2xl font-bold">{{ product.price | money }}</div>
  </a>
</div>
