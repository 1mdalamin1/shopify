<div class="">
    <script src="{{ 'cart.js' | asset_url }}"></script>
    <div class="container">
        <div class="border-t border-[#00000024] pt-8">
            <div class="flex items-center">
               <a class="text-[#00000099]" href="/">Home</a> 
                <svg class="mx-2" xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                <path d="M1.53073 0.469372L6.53073 5.46937C6.60065 5.53905 6.65613 5.62184 6.69399 5.71301C6.73184 5.80417 6.75133 5.90191 6.75133 6.00062C6.75133 6.09933 6.73184 6.19707 6.69399 6.28824C6.65613 6.3794 6.60065 6.46219 6.53073 6.53187L1.53073 11.5319C1.38984 11.6728 1.19874 11.7519 0.999484 11.7519C0.800227 11.7519 0.609131 11.6728 0.468235 11.5319C0.327338 11.391 0.248184 11.1999 0.248184 11.0006C0.248184 10.8014 0.327338 10.6103 0.468235 10.4694L4.93761 6L0.46761 1.53062C0.326714 1.38973 0.247559 1.19863 0.247559 0.999372C0.247559 0.800115 0.326714 0.609018 0.46761 0.468122C0.608506 0.327227 0.799603 0.24807 0.99886 0.24807C1.19812 0.24807 1.38921 0.327227 1.53011 0.468122L1.53073 0.469372Z" fill="black" fill-opacity="0.6"/>
                </svg>
               <span>Cart</span>
            </div>
            <h1 class="text-[40px] mb-6 mt-6">Your Cart</h1>
            <!-- Cart if statement -->
            <div id="cart-content">
                <div class="mb-20">
                    <div class="container">
                        <div class="flex gap-4">
                            <div class="w-7/12">
                                <form action="{{ routes.cart_url }}" method="post">
                                    <div class="rounded-2xl border border-[#F0EEED]">
                                        <div id="cart-items"></div>
                                    </div>
                                </form>
                            </div>
                            <div class="w-5/12">
                                <div class="rounded-2xl border border-[#F0EEED]">
                                    <div class="p-6 font_s">
                                        <h2 class="font-bold text-2xl capitalize">Order Summary</h2>
                                        <div class="border-b border-[#F0EEED] mt-6 pb-6">
                                            <div class="flex justify-between">
                                                <span class="text-[#00000099] text-xl">Subtotal</span>
                                                <span class="text-[#00000099] font-bold text-xl">{{ cart.items_subtotal_price | money }}</span>
                                            </div>
                                            <div class="flex justify-between mt-6">
                                                <span class="text-[#00000099] text-xl">Discount (-20%)</span>
                                                <span class="text-[#FF3333] font-bold text-xl">{{ cart.total_discount | money }}</span>
                                            </div>
                                            <div class="flex justify-between mt-6">
                                                <span class="text-[#00000099] text-xl">Subtotal</span>
                                                <span class="text-[#00000099] font-bold text-xl">{{ cart.original_total_price | money }}</span>
                                            </div>
                                        </div>
                                        <div class="flex justify-between mt-6 ">
                                            <span class="text-[#00000099] text-xl">Total</span>
                                            <span class="text-[#00000099] font-bold text-xl">{{ cart.total_price | money }}</span>
                                        </div>
                                        <div class="py-6">
                                            <div class="flex items-center justify-between">
                                                <div class="10/12 w-full mr-2 bg-[#F0F0F0] px-4 py-2 rounded-full">
                                                    <input type="text" class="border border-[#F0EEED] rounded-2xl py-2 px-2 focus:outline-none w-full" placeholder="Add Promo Code">
                                                </div>
                                                <div class="2/12 flex justify-end">
                                                    <button class="bg-black text-white w-full rounded-full py-4 px-8 cursor-pointer">Apply</button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex items-center bg-black w-full rounded-full py-4 px-4 mt-6 justify-center cursor-pointer">
                                            <div class="text-white pr-2"><a href="/checkout" class="text-white pr-2">Go to Checkout</a></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> 
            </div>
            
            <!-- Empty Cart Message -->
            <div id="empty-cart" class="hidden text-2xl text-center bold my-5">
                Your Cart Is Empty
                <div class="text-center mb-5">
                    <a href="/" class="text-blue-500 underline">Return To Shop</a>
                </div>
            </div>
            
            <script>
                $(document).ready(function () {
                    $.getJSON('/cart.js', function (cart) {
                        if (cart.item_count === 0) {
                            $("#cart-content").hide();
                            $("#empty-cart").removeClass("hidden");
                        } else {
                            $("#cart-content").show();
                            $("#empty-cart").addClass("hidden");
                        }
                    });
                });
            </script>
            
    </div>
</div>


