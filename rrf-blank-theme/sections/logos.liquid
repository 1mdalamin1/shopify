<div class="bg-black py-10">
    <div class="container">
        <div class="flex justify-between">
            {% for block in section.blocks %}
                {%- case block.type -%}
                  {%- when "logos" -%}
                    <div class="brand-logos">
                        {{ block.settings.image | image_url: width: 200 | image_tag }}
                    </div>
                {% endcase %}
              {% endfor %}
        </div>
    </div>
</div>
{% schema  %} 
    {
        "name": "Brand-Logos",
        "disabled_on": {
            "groups": ["header", "footer"]
        },
        "name": "Brand-Logos",
        "blocks": [{
            "type": "logos",
            "name": "Logos",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Upload Image"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "Url"
                }
            ]
            
        }],
        "presets": [
            {
                "name": "Brand-Logos"
            }
        ]
    }
{% endschema %}  
