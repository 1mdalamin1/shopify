<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}
<h2 class="tanvir">This is the Dawn Theme</h2>
<h3>It's time to see, what I can do. to test the limit and bread the rule</h3>
    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
