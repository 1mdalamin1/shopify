<div class="pt-20 pb-10">
    <div class="container">
        <h2 class="text-center text-[48px] mb-8 uppercase">{{ section.settings.title }}</h2>
        {% assign columns = section.settings.product_columns | default: 4 %}
        {% assign columns_width = 100 | divided_by: columns %}
        <div class="flex flex-wrap -mx-4">
            {% for product in collections[section.settings.collection].products %}
                <div class="product-item px-2 single-product-box" style="width: {{ columns_width }}%;">
                    {% render 'product_item', product: product %}
                </div>
            {% endfor %}
        </div>
        <div class="flex justify-center mt-8 pb-16 border-b border-[#00000024]">
            <a class="px-10 py-2 border border-[#00000024] rounded-full" href="{{ section.settings.url }}">{{ section.settings.link_text }}</a>
        </div>
    </div>
</div>

{%  schema  %}  
    {
        "name": "Product-Grid",
        "disabled_on": {
                "groups": ["header", "footer"]
        },
        "settings": [
            {
                "id": "title",
                "type": "text",
                "label": "title",
                "default": "NEW ARRIVALS"
            },
            {
                "id": "collection",
                "type": "collection",
                "label": "Collection"
            },
            {
                "id": "url",
                "type": "url",
                "label": "Link"
            },
            {
                "id": "link_text",
                "type": "text",
                "label": "Link Test",
                "default": "View All"
            },
                {
                "type": "select",
                "id": "product_columns",
                "label": "Select Product Columns",
                "options": [
                    { "value": "2", "label": "2 columns" },
                    { "value": "3", "label": "3 columns" },
                    { "value": "4", "label": "4 columns" },
                    { "value": "5", "label": "5 columns" },
                    { "value": "6", "label": "6 columns" }
                ],
                "default": "4"
                }
            
            
        ],
        "presets": [
            {
                "name": "Product-Grid" 
            }
          
        ]  
    }
{% endschema %} 